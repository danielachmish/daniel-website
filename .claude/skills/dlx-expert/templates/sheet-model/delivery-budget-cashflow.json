  "calcs": [
    {
      "section": "נפח, קיבולת והכנסות"
    },
    {
      "name": "Deliveries",
      "label": "משלוחים בחודש",
      "unit": "משלוחים",
      "format": "int",
      "formula": "=ROUND(DeliveriesPerDay*{WorkingDays}*{Seasonality},0)"
    },
    {
      "name": "FailedDeliveries",
      "label": "ניסיונות מסירה חוזרים",
      "unit": "משלוחים",
      "format": "int",
      "formula": "=ROUND({Deliveries}*FailedRate,0)"
    },
    {
      "name": "DriversNeeded",
      "label": "נהגים שצריך לפי הקיבולת",
      "unit": "נהגים",
      "format": "int",
      "total": "max",
      "formula": "=IF({WorkingDays}=0,0,ROUNDUP({Deliveries}/{WorkingDays}/MaxPerDriverDay,0))"
    },
    {
      "name": "ActiveDrivers",
      "label": "נהגים בפועל (קבועים + תוספת בעומס)",
      "unit": "נהגים",
      "format": "int",
      "total": "max",
      "formula": "=MAX(Drivers,{DriversNeeded})"
    },
    {
      "name": "Revenue",
      "label": "הכנסות (לפני מע\"מ)",
      "unit": "₪",
      "format": "money",
      "bold": true,
      "formula": "={Deliveries}*PricePerDelivery"
    },
    {
      "section": "עלויות משתנות"
    },
    {
      "name": "FuelCost",
      "label": "דלק",
      "unit": "₪",
      "formula": "={Deliveries}*FuelPerDelivery"
    },
    {
      "name": "RedeliveryCostTotal",
      "label": "ניסיונות מסירה חוזרים",
      "unit": "₪",
      "formula": "={FailedDeliveries}*RedeliveryCost"
    },
    {
      "name": "MessagingCost",
      "label": "הודעות לנמענים",
      "unit": "₪",
      "formula": "={Deliveries}*MessagingPerDelivery"
    },
    {
      "name": "SuppliesCost",
      "label": "מדבקות וחומרים",
      "unit": "₪",
      "formula": "={Deliveries}*SuppliesPerDelivery"
    },
    {
      "name": "OtherVarCost",
      "label": "עלות משתנה נוספת (שורה שמורה)",
      "unit": "₪",
      "formula": "={Deliveries}*OtherVarPerDelivery"
    },
    {
      "name": "LostParcelCost",
      "label": "פיצוי על חבילות שאבדו (בלי מע\"מ)",
      "unit": "₪",
      "formula": "={Deliveries}*LostParcelRate*CompensationPerParcel"
    },
    {
      "name": "BadDebt",
      "label": "חובות שלא ייגבו",
      "unit": "₪",
      "formula": "={Revenue}*BadDebtRate"
    },
    {
      "name": "VariableCosts",
      "label": "סה\"כ עלויות משתנות",
      "unit": "₪",
      "bold": true,
      "formula": "=SUM({FuelCost..BadDebt})"
    },
    {
      "section": "עלויות קבועות"
    },
    {
      "name": "PayrollCost",
      "label": "שכר כולל עלות מעסיק",
      "unit": "₪",
      "formula": "=({ActiveDrivers}*DriverGrossSalary+WarehouseStaffSalary)*(1+EmployerCostRate)"
    },
    {
      "name": "LeaseCost",
      "label": "ליסינג רכבים קבועים",
      "unit": "₪",
      "formula": "=Drivers*VehicleLeasePerDriver"
    },
    {
      "name": "ExtraVehicleCost",
      "label": "רכב שכור לנהגים נוספים בעונה",
      "unit": "₪",
      "formula": "=({ActiveDrivers}-Drivers)*SeasonalVehicleRent"
    },
    {
      "name": "InsuranceCost",
      "label": "ביטוח רכבים קבועים",
      "unit": "₪",
      "formula": "=Drivers*VehicleInsurancePerDriver"
    },
    {
      "name": "OverheadCost",
      "label": "מחסן, תוכנות, הנהלת חשבונות ושונות",
      "unit": "₪",
      "formula": "=WarehouseRent+SoftwareMonthly+AccountingMonthly+OtherFixed+OtherFixed2"
    },
    {
      "name": "FixedCosts",
      "label": "סה\"כ עלויות קבועות",
      "unit": "₪",
      "bold": true,
      "formula": "=SUM({PayrollCost..OverheadCost})"
    },
    {
      "section": "רווח"
    },
    {
      "name": "TotalCosts",
      "label": "סה\"כ עלויות",
      "unit": "₪",
      "bold": true,
      "formula": "={VariableCosts}+{FixedCosts}"
    },
    {
      "name": "OperatingProfit",
      "label": "רווח תפעולי (לפני מס הכנסה ומשיכות)",
      "unit": "₪",
      "bold": true,
      "formula": "={Revenue}-{TotalCosts}"
    },
    {
      "name": "OperatingMargin",
      "label": "שיעור רווח תפעולי",
      "unit": "%",
      "format": "pct",
      "total": "none",
      "formula": "=IF({Revenue}=0,0,{OperatingProfit}/{Revenue})"
    },
    {
      "section": "מע\"מ"
    },
    {
      "name": "OutputVat",
      "label": "מע\"מ עסקאות (על ההכנסות)",
      "unit": "₪",
      "formula": "={Revenue}*VatRate"
    },
    {
      "name": "VatableCosts",
      "label": "הוצאות שחייבות במע\"מ (עלויות משתנות חוץ מחובות ופיצויים, ליסינג, רכב שכור ותקורה)",
      "unit": "₪",
      "formula": "={VariableCosts}-{BadDebt}-{LostParcelCost}+{LeaseCost}+{ExtraVehicleCost}+{OverheadCost}"
    },
    {
      "name": "InputVat",
      "label": "מע\"מ תשומות (כולל על ציוד)",
      "unit": "₪",
      "formula": "={VatableCosts}*VatRate+{EquipmentPurchases}*VatRate/(1+VatRate)"
    },
    {
      "name": "NetVat",
      "label": "מע\"מ לתשלום על החודש",
      "unit": "₪",
      "formula": "={OutputVat}-{InputVat}"
    },
    {
      "section": "תזרים מזומנים (מה באמת נכנס ויוצא מהבנק)"
    },
    {
      "name": "Collections",
      "label": "גבייה מחנויות (כולל מע\"מ, פחות חובות אבודים)",
      "unit": "₪",
      "formula": "=IF(CollectionLagMonths=1,{Revenue[-1]},{Revenue[-2]})*(1+VatRate)*(1-BadDebtRate)",
      "first": [
        "=OpeningReceivables*(1-BadDebtRate)",
        "=IF(CollectionLagMonths=1,{Revenue[-1]}*(1+VatRate),OpeningReceivables2)*(1-BadDebtRate)"
      ]
    },
    {
      "name": "PayrollPaid",
      "label": "תשלום משכורות (של החודש הקודם)",
      "unit": "₪",
      "formula": "={PayrollCost[-1]}",
      "first": "=OpeningPayroll"
    },
    {
      "name": "SupplierPayments",
      "label": "תשלום לספקים (כולל מע\"מ)",
      "unit": "₪",
      "formula": "={VatableCosts}*(1+VatRate)+{InsuranceCost}+{LostParcelCost}"
    },
    {
      "name": "VatPaid",
      "label": "תשלום מע\"מ (של החודש הקודם)",
      "unit": "₪",
      "formula": "={NetVat[-1]}",
      "first": "=OpeningVatPayable"
    },
    {
      "name": "TaxAdvancePaid",
      "label": "מקדמת מס הכנסה (על מחזור החודש הקודם)",
      "unit": "₪",
      "formula": "={Revenue[-1]}*TaxAdvanceRate",
      "first": "=OpeningTaxAdvance"
    },
    {
      "name": "EquipmentPaid",
      "label": "רכישת ציוד",
      "unit": "₪",
      "formula": "={EquipmentPurchases}"
    },
    {
      "name": "InterestPaid",
      "label": "ריבית על המסגרת (לפי ימים: השפל עד הגבייה, ויתרת הסוף אחריה)",
      "unit": "₪",
      "formula": "=OverdraftMonthlyRate*(MAX(0,-{IntraMonthLow[-1]})*{LowShare[-1]}+MAX(0,-{ClosingCash[-1]})*(1-{LowShare[-1]}))",
      "first": "=OverdraftMonthlyRate*MAX(0,-OpeningCash)"
    },
    {
      "name": "OwnerNIPaid",
      "label": "ביטוח לאומי ומס בריאות של הבעלים",
      "unit": "₪",
      "formula": "=OwnerNI"
    },
    {
      "name": "OwnerDrawPaid",
      "label": "משיכת הבעלים",
      "unit": "₪",
      "formula": "=OwnerDraw"
    },
    {
      "name": "NetCashFlow",
      "label": "תזרים נטו בחודש",
      "unit": "₪",
      "bold": true,
      "formula": "={Collections}-SUM({PayrollPaid..OwnerDrawPaid})"
    },
    {
      "name": "OpeningCashBal",
      "label": "יתרה בתחילת החודש",
      "unit": "₪",
      "total": "first",
      "formula": "={ClosingCash[-1]}",
      "first": "=OpeningCash"
    },
    {
      "name": "ClosingCash",
      "label": "יתרה בסוף החודש",
      "unit": "₪",
      "bold": true,
      "total": "last",
      "formula": "={OpeningCashBal}+{NetCashFlow}"
    },
    {
      "name": "PreCollectionOut",
      "label": "יוצא מהבנק לפני שהחנויות משלמות (בלי ריבית)",
      "unit": "₪",
      "formula": "={PayrollPaid}*(PayrollDay<CollectionDay)+{SupplierPayments}*(SupplierDay<CollectionDay)+{VatPaid}*(VatDay<CollectionDay)+({TaxAdvancePaid}+{OwnerNIPaid})*(TaxDay<CollectionDay)+{EquipmentPaid}*(EquipmentDay<CollectionDay)+{OwnerDrawPaid}*(OwnerDrawDay<CollectionDay)"
    },
    {
      "name": "AvgOutDay",
      "label": "היום הממוצע שבו הכסף יוצא (משוקלל בסכומים)",
      "unit": "יום",
      "format": "num",
      "total": "none",
      "formula": "=IF({PreCollectionOut}=0,CollectionDay,({PayrollPaid}*(PayrollDay<CollectionDay)*PayrollDay+{SupplierPayments}*(SupplierDay<CollectionDay)*SupplierDay+{VatPaid}*(VatDay<CollectionDay)*VatDay+({TaxAdvancePaid}+{OwnerNIPaid})*(TaxDay<CollectionDay)*TaxDay+{EquipmentPaid}*(EquipmentDay<CollectionDay)*EquipmentDay+{OwnerDrawPaid}*(OwnerDrawDay<CollectionDay)*OwnerDrawDay)/{PreCollectionOut})"
    },
    {
      "name": "LowShare",
      "label": "חלק מהחודש שבו הבנק בשפל",
      "unit": "%",
      "format": "pct",
      "total": "none",
      "formula": "=MAX(0,CollectionDay-{AvgOutDay})/DaysPerMonth"
    },
    {
      "name": "IntraMonthLow",
      "label": "הנקודה הנמוכה בבנק בתוך החודש (לפני שהחנויות משלמות)",
      "unit": "₪",
      "bold": true,
      "total": "min",
      "formula": "=MIN({ClosingCash},{OpeningCashBal}-{PreCollectionOut}-{InterestPaid})"
    },
    {
      "name": "BufferLine",
      "label": "כרית ביטחון",
      "unit": "₪",
      "total": "none",
      "formula": "=MinCashBuffer"
    },
    {
      "name": "BelowBuffer",
      "label": "חודש שבו הבנק יורד מתחת לכרית (1 = כן)",
      "unit": "חודשים",
      "format": "int",
      "formula": "=IF({IntraMonthLow}<MinCashBuffer,1,0)"
    }
  ],
  "outputs": {
    "kpis": [
      {
        "label": "הכנסות בשנה (לפני מע\"מ)",
        "name": "Kpi_Revenue",
        "formula": "={Revenue:total}",
        "format": "money"
      },
      {
        "label": "רווח תפעולי בשנה (לפני ריבית, מס ומשיכות)",
        "name": "Kpi_Profit",
        "formula": "={OperatingProfit:total}",
        "format": "money"
      },
      {
        "label": "שיעור רווח תפעולי",
        "name": "Kpi_Margin",
        "formula": "=IF({Revenue:total}=0,0,{OperatingProfit:total}/{Revenue:total})",
        "format": "pct"
      },
      {
        "label": "רווח ממוצע לכל משלוח",
        "name": "Kpi_PerDelivery",
        "formula": "=IF({Deliveries:total}=0,0,{OperatingProfit:total}/{Deliveries:total})",
        "format": "money2"
      },
      {
        "label": "הנקודה הנמוכה בבנק בשנה (בתוך החודש)",
        "name": "Kpi_MinCash",
        "formula": "=MIN({IntraMonthLow:row})",
        "format": "money"
      },
      {
        "label": "החודש של הנקודה הנמוכה",
        "name": "Kpi_LowMonth",
        "formula": "=INDEX({Periods:row},MATCH(MIN({IntraMonthLow:row}),{IntraMonthLow:row},0))",
        "format": "month"
      },
      {
        "label": "חודשים שבהם הבנק יורד מתחת לכרית",
        "name": "Kpi_BelowBuffer",
        "formula": "={BelowBuffer:total}",
        "format": "int"
      },
      {
        "label": "מסגרת אשראי שצריך כדי לא לרדת מתחת לכרית",
        "name": "Kpi_Credit",
        "formula": "=MAX(0,MinCashBuffer-MIN({IntraMonthLow:row}))",
        "format": "money"
      },
      {
        "label": "ריבית על המסגרת בשנה",
        "name": "Kpi_Interest",
        "formula": "={InterestPaid:total}",
        "format": "money"
      },
      {
        "label": "נהגים בחודש הכי עמוס",
        "name": "Kpi_PeakDrivers",
        "formula": "={ActiveDrivers:total}",
        "format": "int"
      },
      {
        "section": "מה זה אומר (מתעדכן לבד)"
      },
      {
        "label": "חודש בהפסד?",
        "format": "text",
        "formula": "=IF(MIN({OperatingProfit:row})<0,\"כן: \"&COUNTIF({OperatingProfit:row},\"<0\")&\" חודשים. החלש: \"&TEXT(INDEX({Periods:row},MATCH(MIN({OperatingProfit:row}),{OperatingProfit:row},0)),\"mm/yyyy\")&\". לתכנן את המזומן מראש\",\"לא, כל החודשים ברווח\")"
      },
      {
        "label": "המזומן מספיק?",
        "format": "text",
        "formula": "=IF(Kpi_BelowBuffer>0,\"לא: ב-\"&Kpi_BelowBuffer&\" חודשים הבנק יורד מתחת לכרית לפני שהחנויות משלמות. צריך מסגרת של \"&TEXT(Kpi_Credit,\"#,##0\")&\" ₪ (ריבית בערך \"&TEXT(Kpi_Interest,\"#,##0\")&\" ₪ בשנה), או להקטין משיכות\",\"כן, עם מרווח\")",
        "name": "Kpi_CashText"
      },
      {
        "label": "הבעלים מושכים יותר מהרווח?",
        "format": "text",
        "formula": "=IF((OwnerDraw+OwnerNI)*COUNT({Revenue:row})>Kpi_Profit-{TaxAdvancePaid:total}-Kpi_Interest,\"כן: משיכות וביטוח לאומי \"&TEXT((OwnerDraw+OwnerNI)*COUNT({Revenue:row}),\"#,##0\")&\" ₪ בשנה, מול רווח אחרי מקדמות וריבית של \"&TEXT(Kpi_Profit-{TaxAdvancePaid:total}-Kpi_Interest,\"#,##0\")&\" ₪. ההפרש יוצא מהמזומן\",\"לא, הרווח מכסה את המשיכות\")",
        "name": "Kpi_DrawText"
      },
      {
        "label": "נקודת איזון: משלוחים בחודש שמכסים את ההוצאות הקבועות",
        "name": "Kpi_BreakEven",
        "formula": "=IF({Deliveries:total}=0,0,IF(PricePerDelivery<={VariableCosts:total}/{Deliveries:total},0,ROUNDUP(({FixedCosts:total}/COUNT({FixedCosts:row}))/(PricePerDelivery-{VariableCosts:total}/{Deliveries:total}),0)))",
        "format": "int",
        "note": "0 = המחיר לא מכסה אפילו את העלות המשתנה"
      },
      {
        "section": "מה אם"
      },
      {
        "label": "אם המחיר למשלוח עולה (בסכום שבהנחות): רווח שנתי",
        "name": "Kpi_SensPrice",
        "formula": "={OperatingProfit:total}+{Deliveries:total}*SensPriceStep*(1-BadDebtRate)",
        "format": "money",
        "note": "בערך: בלי שינוי בנפח"
      },
      {
        "label": "אם הנפח יורד (באחוז שבהנחות): רווח שנתי",
        "name": "Kpi_SensVolume",
        "formula": "={OperatingProfit:total}-SensVolumePct*({Revenue:total}-{VariableCosts:total})",
        "format": "money",
        "note": "בערך: בלי לצמצם נהגים"
      },
      {
        "label": "אם החנויות משלמות ביום שבהנחות (ולא בסוף החודש): מסגרת שצריך",
        "name": "Kpi_CreditIfEarly",
        "formula": "=MAX(0,MinCashBuffer-SUMPRODUCT(MIN({ClosingCash:row},{OpeningCashBal:row}-({PayrollPaid:row}*(PayrollDay<SensCollectionDay)+{SupplierPayments:row}*(SupplierDay<SensCollectionDay)+{VatPaid:row}*(VatDay<SensCollectionDay)+({TaxAdvancePaid:row}+{OwnerNIPaid:row})*(TaxDay<SensCollectionDay)+{EquipmentPaid:row}*(EquipmentDay<SensCollectionDay)+{InterestPaid:row}+{OwnerDrawPaid:row}*(OwnerDrawDay<SensCollectionDay)))))",
        "format": "money",
        "note": "בערך: בלי שינוי בריבית. ההנחה הכי רגישה במודל"
      },
      {
        "section": "תקציב מול ביצוע, מצטבר"
      },
      {
        "label": "חודשים שהוזן להם ביצוע",
        "name": "Kpi_ActualMonths",
        "formula": "=COUNT({ActualRevenue:row})",
        "format": "int"
      },
      {
        "label": "סטייה מצטברת בהכנסות",
        "formula": "=IF(COUNT({ActualRevenue:row})=0,\"עוד לא הוזן ביצוע\",SUM({Out_RevenueVar:row}))",
        "format": "money",
        "name": "Kpi_RevVarYtd"
      },
      {
        "label": "סטייה מצטברת בעלויות",
        "formula": "=IF(COUNT({ActualCosts:row})=0,\"עוד לא הוזן ביצוע\",SUM({Out_CostVar:row}))",
        "format": "money",
        "name": "Kpi_CostVarYtd"
      }
    ],
    "table_title": "חודש אחרי חודש",
    "table": [
      {
        "label": "הכנסות",
        "ref": "Revenue"
      },
      {
        "label": "עלויות משתנות",
        "ref": "VariableCosts"
      },
      {
        "label": "עלויות קבועות",
        "ref": "FixedCosts"
      },
      {
        "label": "רווח תפעולי",
        "ref": "OperatingProfit",
        "bold": true
      },
      {
        "label": "נהגים בפועל",
        "ref": "ActiveDrivers",
        "unit": "נהגים",
        "format": "int",
        "total": "max"
      },
      {
        "label": "תזרים נטו",
        "ref": "NetCashFlow"
      },
      {
        "label": "יתרה בבנק בסוף החודש",
        "ref": "ClosingCash",
        "total": "last",
        "bold": true
      },
      {
        "label": "הנקודה הנמוכה בחודש",
        "ref": "IntraMonthLow",
        "total": "min",
        "bold": true
      },
      {
        "label": "כרית ביטחון",
        "ref": "BufferLine",
        "total": "none"
      },
      {
        "section": "תקציב מול ביצוע (מתמלא כשמזינים ביצוע בלשונית ההנחות)"
      },
      {
        "label": "הכנסות בפועל",
        "name": "Out_ActualRevenue",
        "formula": "=IF(ISBLANK({ActualRevenue}),\"\",{ActualRevenue})",
        "total": "none"
      },
      {
        "label": "סטייה בהכנסות (בפועל פחות תקציב)",
        "name": "Out_RevenueVar",
        "formula": "=IF(ISBLANK({ActualRevenue}),\"\",{ActualRevenue}-{Revenue})",
        "total": "none"
      },
      {
        "label": "סטייה בעלויות (בפועל פחות תקציב)",
        "name": "Out_CostVar",
        "formula": "=IF(ISBLANK({ActualCosts}),\"\",{ActualCosts}-{TotalCosts})",
        "total": "none"
      },
      {
        "label": "סטייה ביתרה בבנק",
        "name": "Out_CashVar",
        "formula": "=IF(ISBLANK({ActualCash}),\"\",{ActualCash}-{ClosingCash})",
        "total": "none"
      }
    ],
    "chart": {
      "title": "יתרה בבנק: סוף החודש, הנקודה הנמוכה בתוך החודש, וכרית הביטחון",
      "rows": [
        "ClosingCash",
        "IntraMonthLow",
        "BufferLine"
      ],
      "type": "line",
      "title_formula": "=\"המסקנה: \"&IF(MIN({IntraMonthLow:row})<MinCashBuffer,\"הבנק יורד עד \"&TEXT(MIN({IntraMonthLow:row}),\"#,##0\")&\" ₪ ב-\"&TEXT(INDEX({Periods:row},MATCH(MIN({IntraMonthLow:row}),{IntraMonthLow:row},0)),\"mm/yyyy\")&\" (לפני שהחנויות משלמות): צריך מסגרת של \"&TEXT(MAX(0,MinCashBuffer-MIN({IntraMonthLow:row})),\"#,##0\")&\" ₪ או פחות משיכות\",\"הבנק לא יורד מתחת לכרית\")"
    }
  },
  "checks": [
    {
      "label": "הכנסות השנה = משלוחים בשנה × מחיר (חישוב עצמאי מההנחות)",
      "formula": "=ABS({Revenue:total}-{Deliveries:total}*PricePerDelivery)<=Tolerance"
    },
    {
      "label": "משלוחים בשנה = משלוחים ביום × סכום (ימי עבודה × עונתיות), עד עיגול של חצי משלוח בחודש",
      "formula": "=ABS({Deliveries:total}-DeliveriesPerDay*SUMPRODUCT({WorkingDays:row},{Seasonality:row}))<=COUNT({Deliveries:row})"
    },
    {
      "label": "עלויות משתנות בשנה = חישוב עצמאי מהעלות למשלוח",
      "formula": "=ABS({VariableCosts:total}-({Deliveries:total}*(FuelPerDelivery+MessagingPerDelivery+SuppliesPerDelivery+OtherVarPerDelivery+LostParcelRate*CompensationPerParcel)+{FailedDeliveries:total}*RedeliveryCost+{Revenue:total}*BadDebtRate))<=Tolerance"
    },
    {
      "label": "עלויות קבועות בשנה = חישוב עצמאי מחודשי-נהג ומההנחות",
      "formula": "=ABS({FixedCosts:total}-(SUM({ActiveDrivers:row})*DriverGrossSalary*(1+EmployerCostRate)+SUMPRODUCT({ActiveDrivers:row}-Drivers)*SeasonalVehicleRent+COUNT({ActiveDrivers:row})*(WarehouseStaffSalary*(1+EmployerCostRate)+Drivers*(VehicleLeasePerDriver+VehicleInsurancePerDriver)+WarehouseRent+SoftwareMonthly+AccountingMonthly+OtherFixed+OtherFixed2)))<=Tolerance"
    },
    {
      "label": "רווח שנתי = הכנסות פחות עלויות",
      "formula": "=ABS({OperatingProfit:total}-({Revenue:total}-{TotalCosts:total}))<=Tolerance"
    },
    {
      "label": "גשר מזומנים: יתרת סוף = יתרת פתיחה + תזרים נטו של כל התקופה",
      "formula": "=ABS({ClosingCash:last}-(OpeningCash+{NetCashFlow:total}))<=Tolerance"
    },
    {
      "label": "גבייה: (חוב פתיחה + הכנסות כולל מע\"מ − מה שעוד לא נפרע) × (1 − חובות אבודים) = נגבה",
      "formula": "=ABS((OpeningReceivables+IF(CollectionLagMonths=1,0,OpeningReceivables2)+({Revenue:total}-IF(CollectionLagMonths=1,{Revenue:last},{Revenue:last}+INDEX({Revenue:row},COUNT({Revenue:row})-1)))*(1+VatRate))*(1-BadDebtRate)-{Collections:total})<=Tolerance"
    },
    {
      "label": "מע\"מ: חוב פתיחה + מע\"מ התקופה = שולם + חוב סגירה; עסקאות = הכנסות × שיעור; תשומות = שיעור × הוצאות חייבות + החלק של הציוד; נטו = עסקאות − תשומות",
      "formula": "=AND(ABS(OpeningVatPayable+{NetVat:total}-{VatPaid:total}-{NetVat:last})<=Tolerance,ABS({OutputVat:total}-{Revenue:total}*VatRate)<=Tolerance,ABS({InputVat:total}-VatRate*({FuelCost:total}+{RedeliveryCostTotal:total}+{MessagingCost:total}+{SuppliesCost:total}+{OtherVarCost:total}+{LeaseCost:total}+{ExtraVehicleCost:total}+{OverheadCost:total})-SUM({EquipmentPurchases:row})*VatRate/(1+VatRate))<=Tolerance,ABS({NetVat:total}-({OutputVat:total}-{InputVat:total}))<=Tolerance)"
    },
    {
      "label": "שכר: חוב פתיחה + שכר התקופה = שולם + חוב סגירה",
      "formula": "=ABS(OpeningPayroll+{PayrollCost:total}-{PayrollPaid:total}-{PayrollCost:last})<=Tolerance"
    },
    {
      "label": "מקדמות מס: חוב פתיחה + מקדמות על מחזור התקופה = שולם + חוב סגירה",
      "formula": "=ABS(OpeningTaxAdvance+({Revenue:total}-{Revenue:last})*TaxAdvanceRate-{TaxAdvancePaid:total})<=Tolerance"
    },
    {
      "label": "חודשים מתחת לכרית = ספירה עצמאית של שפלים מתחת לכרית",
      "formula": "={BelowBuffer:total}=COUNTIF({IntraMonthLow:row},\"<\"&MinCashBuffer)"
    },
    {
      "label": "הטבלה בלשונית התוצאות זהה לחישובים בכל חודש",
      "formula": "=SUMPRODUCT(ABS({Out_Revenue:row}-{Revenue:row}))+SUMPRODUCT(ABS({Out_VariableCosts:row}-{VariableCosts:row}))+SUMPRODUCT(ABS({Out_FixedCosts:row}-{FixedCosts:row}))+SUMPRODUCT(ABS({Out_OperatingProfit:row}-{OperatingProfit:row}))+SUMPRODUCT(ABS({Out_NetCashFlow:row}-{NetCashFlow:row}))+SUMPRODUCT(ABS({Out_ClosingCash:row}-{ClosingCash:row}))+SUMPRODUCT(ABS({Out_IntraMonthLow:row}-{IntraMonthLow:row}))+SUMPRODUCT(ABS({Out_ActiveDrivers:row}-{ActiveDrivers:row}))+SUMPRODUCT(ABS({Out_BufferLine:row}-MinCashBuffer))+SUMPRODUCT(ABS({BufferLine:row}-MinCashBuffer))<=Tolerance"
    },
    {
      "label": "סבירות: אף חודש לא דורש יותר משלוחים לנהג ממה שנהג מספיק",
      "formula": "=SUMPRODUCT(--({Deliveries:row}>{ActiveDrivers:row}*{WorkingDays:row}*MaxPerDriverDay))=0"
    },
    {
      "label": "סבירות: אין חודש עם משלוחים, ימי עבודה או נהגים שליליים",
      "formula": "=AND(MIN({Deliveries:row})>=0,MIN({WorkingDays:row})>=0,MIN({ActiveDrivers:row})>=0)"
    },
    {
      "label": "תזרים: יציאות השנה = חישוב עצמאי מסכומי העלויות, המע\"מ, המקדמות, הריבית והמשיכות",
      "formula": "=ABS(({Collections:total}-{NetCashFlow:total})-({PayrollPaid:total}+{SupplierPayments:total}+{VatPaid:total}+{TaxAdvancePaid:total}+{InterestPaid:total}+SUM({EquipmentPurchases:row})+COUNT({Revenue:row})*(OwnerNI+OwnerDraw)))<=Tolerance"
    },
    {
      "label": "ספקים: תשלום לספקים = כל העלויות חוץ משכר וחובות אבודים, ועוד מע\"מ תשומות (בלי החלק של הציוד)",
      "formula": "=ABS({SupplierPayments:total}-({TotalCosts:total}-{PayrollCost:total}-{BadDebt:total}+{InputVat:total}-SUM({EquipmentPurchases:row})*VatRate/(1+VatRate)))<=Tolerance"
    },
    {
      "label": "ניסיונות חוזרים בשנה = משלוחים × אחוז כישלון (עד עיגול)",
      "formula": "=ABS({FailedDeliveries:total}-{Deliveries:total}*FailedRate)<=COUNT({Deliveries:row})"
    },
    {
      "label": "נהגים: בכל חודש בדיוק כמה שצריך (מספיק, ואחד פחות כבר לא היה מספיק), ולא פחות מהקבועים",
      "formula": "=AND(SUMPRODUCT(--({DriversNeeded:row}*{WorkingDays:row}*MaxPerDriverDay<{Deliveries:row}))=0,SUMPRODUCT(--(({DriversNeeded:row}-1)*{WorkingDays:row}*MaxPerDriverDay>={Deliveries:row}),--({Deliveries:row}>0))=0,SUMPRODUCT(--({ActiveDrivers:row}<Drivers))=0,SUMPRODUCT(--({ActiveDrivers:row}>Drivers),--({ActiveDrivers:row}<>{DriversNeeded:row}))=0)"
    },
    {
      "label": "שיעור רווח בכל חודש × הכנסות = רווח",
      "formula": "=SUMPRODUCT(ABS({OperatingMargin:row}*{Revenue:row}-{OperatingProfit:row}))<=Tolerance"
    },
    {
      "label": "השפל בתוך החודש = המינימום בין יתרת הסוף לפתיחה פחות מה שיוצא לפני הגבייה (חישוב וקטורי עצמאי)",
      "formula": "=AND(SUMPRODUCT(ABS({PreCollectionOut:row}-({PayrollPaid:row}*(PayrollDay<CollectionDay)+{SupplierPayments:row}*(SupplierDay<CollectionDay)+{VatPaid:row}*(VatDay<CollectionDay)+({TaxAdvancePaid:row}+{OwnerNIPaid:row})*(TaxDay<CollectionDay)+{EquipmentPaid:row}*(EquipmentDay<CollectionDay)+{OwnerDrawPaid:row}*(OwnerDrawDay<CollectionDay))))<=Tolerance,SUMPRODUCT(ABS(({ClosingCash:row}+({OpeningCashBal:row}-({PayrollPaid:row}*(PayrollDay<CollectionDay)+{SupplierPayments:row}*(SupplierDay<CollectionDay)+{VatPaid:row}*(VatDay<CollectionDay)+({TaxAdvancePaid:row}+{OwnerNIPaid:row})*(TaxDay<CollectionDay)+{EquipmentPaid:row}*(EquipmentDay<CollectionDay)+{OwnerDrawPaid:row}*(OwnerDrawDay<CollectionDay))-{InterestPaid:row})-ABS({ClosingCash:row}-({OpeningCashBal:row}-({PayrollPaid:row}*(PayrollDay<CollectionDay)+{SupplierPayments:row}*(SupplierDay<CollectionDay)+{VatPaid:row}*(VatDay<CollectionDay)+({TaxAdvancePaid:row}+{OwnerNIPaid:row})*(TaxDay<CollectionDay)+{EquipmentPaid:row}*(EquipmentDay<CollectionDay)+{OwnerDrawPaid:row}*(OwnerDrawDay<CollectionDay))-{InterestPaid:row})))-({IntraMonthLow:row}+{IntraMonthLow:row})))<=Tolerance)"
    },
    {
      "label": "ריבית: חישוב עצמאי מהשפל, מיתרת הסוף ומחלק החודש (וקטורי, חודש קודם מול חודש נוכחי)",
      "formula": "=ABS(({InterestPaid:total}+{InterestPaid:total})-OverdraftMonthlyRate*(SUMPRODUCT((ABS({IntraMonthLow:head})-{IntraMonthLow:head})*{LowShare:head}+(ABS({ClosingCash:head})-{ClosingCash:head})*(1-{LowShare:head}))+ABS(OpeningCash)-OpeningCash))<=Tolerance"
    },
    {
      "label": "הדשבורד: כל מספר בראש העמוד שווה לחישוב עצמאי שלו",
      "formula": "=AND(ABS(Kpi_Revenue-SUMPRODUCT({Deliveries:row})*PricePerDelivery)<=Tolerance,ABS(Kpi_Profit-({Revenue:total}-{TotalCosts:total}))<=Tolerance,ABS(Kpi_Margin*Kpi_Revenue-Kpi_Profit)<=Tolerance,ABS(Kpi_PerDelivery*{Deliveries:total}-Kpi_Profit)<=Tolerance,Kpi_MinCash=MIN({IntraMonthLow:row}),Kpi_LowMonth=INDEX({Periods:row},MATCH(Kpi_MinCash,{IntraMonthLow:row},0)),Kpi_BelowBuffer=COUNTIF({IntraMonthLow:row},\"<\"&MinCashBuffer),ABS(Kpi_Credit-MAX(0,MinCashBuffer-Kpi_MinCash))<=Tolerance,ABS(Kpi_Interest-SUM({InterestPaid:row}))<=Tolerance,Kpi_PeakDrivers=MAX({ActiveDrivers:row}),Kpi_ActualMonths=COUNT({ActualRevenue:row}))"
    },
    {
      "label": "הדשבורד: נקודת איזון ו'מה אם' (בדיקה הפוכה)",
      "formula": "=AND(OR(Kpi_BreakEven=0,AND(Kpi_BreakEven*(PricePerDelivery-{VariableCosts:total}/{Deliveries:total})>={FixedCosts:total}/COUNT({FixedCosts:row}),(Kpi_BreakEven-1)*(PricePerDelivery-{VariableCosts:total}/{Deliveries:total})<{FixedCosts:total}/COUNT({FixedCosts:row}))),ABS(Kpi_SensPrice-Kpi_Profit-{Deliveries:total}*SensPriceStep*(1-BadDebtRate))<=Tolerance,ABS(Kpi_Profit-Kpi_SensVolume-SensVolumePct*({Revenue:total}-{VariableCosts:total}))<=Tolerance)"
    },
    {
      "label": "המשפטים בדשבורד מציגים בדיוק את המספרים שלמעלה (מסגרת, ריבית, חודשים, משיכות)",
      "formula": "=AND(IF(Kpi_BelowBuffer>0,AND(ISNUMBER(SEARCH(TEXT(Kpi_Credit,\"#,##0\"),Kpi_CashText)),ISNUMBER(SEARCH(TEXT(Kpi_Interest,\"#,##0\"),Kpi_CashText)),ISNUMBER(SEARCH(Kpi_BelowBuffer&\" חודשים\",Kpi_CashText))),Kpi_CashText=\"כן, עם מרווח\"),IF((OwnerDraw+OwnerNI)*COUNT({Revenue:row})>Kpi_Profit-{TaxAdvancePaid:total}-Kpi_Interest,ISNUMBER(SEARCH(TEXT((OwnerDraw+OwnerNI)*COUNT({Revenue:row}),\"#,##0\"),Kpi_DrawText)),Kpi_DrawText=\"לא, הרווח מכסה את המשיכות\"))"
    },
    {
      "label": "תקציב מול ביצוע: בכל חודש שהוזן, סטייה = בפועל פחות תקציב (הכנסות, כל העלויות, יתרת סוף החודש)",
      "formula": "=SUMPRODUCT(ISNUMBER({ActualRevenue:row})*ABS(N(+{Out_RevenueVar:row})-({ActualRevenue:row}-{Revenue:row})))+SUMPRODUCT(ISNUMBER({ActualRevenue:row})*ABS(N(+{Out_ActualRevenue:row})-{ActualRevenue:row}))+SUMPRODUCT(ISNUMBER({ActualCosts:row})*ABS(N(+{Out_CostVar:row})-({ActualCosts:row}-{TotalCosts:row})))+SUMPRODUCT(ISNUMBER({ActualCash:row})*ABS(N(+{Out_CashVar:row})-({ActualCash:row}-{ClosingCash:row})))<=Tolerance"
    },
    {
      "label": "מה אם יום הגבייה: המסגרת = כרית פחות השפל הנמוך מבין סוף החודש ומה שיוצא לפני יום הגבייה החדש",
      "formula": "=ABS(Kpi_CreditIfEarly-MAX(0,MinCashBuffer-MIN(MIN({ClosingCash:row}),SUMPRODUCT(MIN({OpeningCashBal:row}-({PayrollPaid:row}*(PayrollDay<SensCollectionDay)+{SupplierPayments:row}*(SupplierDay<SensCollectionDay)+{VatPaid:row}*(VatDay<SensCollectionDay)+({TaxAdvancePaid:row}+{OwnerNIPaid:row})*(TaxDay<SensCollectionDay)+{EquipmentPaid:row}*(EquipmentDay<SensCollectionDay)+{InterestPaid:row}+{OwnerDrawPaid:row}*(OwnerDrawDay<SensCollectionDay)))))))<=Tolerance"
    },
    {
      "label": "הדשבורד: סטייה מצטברת = סכום הסטיות החודשיות",
      "formula": "=AND(IF(Kpi_ActualMonths=0,Kpi_RevVarYtd=\"עוד לא הוזן ביצוע\",ABS(N(+Kpi_RevVarYtd)-SUMPRODUCT(ISNUMBER({ActualRevenue:row})*({ActualRevenue:row}-{Revenue:row})))<=Tolerance),IF(COUNT({ActualCosts:row})=0,Kpi_CostVarYtd=\"עוד לא הוזן ביצוע\",ABS(N(+Kpi_CostVarYtd)-SUMPRODUCT(ISNUMBER({ActualCosts:row})*({ActualCosts:row}-{TotalCosts:row})))<=Tolerance))"
    },
    {
      "label": "יום יציאה ממוצע וחלק החודש בשפל = חישוב עצמאי מימי התשלום",
      "formula": "=AND(SUMPRODUCT(ABS({AvgOutDay:row}*{PreCollectionOut:row}-({PayrollPaid:row}*(PayrollDay<CollectionDay)*PayrollDay+{SupplierPayments:row}*(SupplierDay<CollectionDay)*SupplierDay+{VatPaid:row}*(VatDay<CollectionDay)*VatDay+({TaxAdvancePaid:row}+{OwnerNIPaid:row})*(TaxDay<CollectionDay)*TaxDay+{EquipmentPaid:row}*(EquipmentDay<CollectionDay)*EquipmentDay+{OwnerDrawPaid:row}*(OwnerDrawDay<CollectionDay)*OwnerDrawDay)))<=Tolerance,SUMPRODUCT(ABS(({LowShare:row}+{LowShare:row})*DaysPerMonth-(ABS(CollectionDay-{AvgOutDay:row})+(CollectionDay-{AvgOutDay:row}))))<=Tolerance)"
    }
  ],
  "howto": [
    "השאלה שהקובץ עונה עליה: כמה נרוויח השנה, באיזה חודש הכסף בבנק הכי נמוך, וכמה נהגים צריך בכל חודש.",
    "1. משנים מספרים רק בלשונית 'הנחות', בתאים הצהובים עם הכתב הכחול. כל השאר מחושב ונעול כדי שלא יימחק בטעות.",
    "2. התשובה בלשונית 'תוצאות': רווח, היתרה הנמוכה ובאיזה חודש, נהגים בחודש העמוס, 'מה זה אומר' במילים, ו'מה אם' למחיר ולנפח.",
    "3. בסוף כל חודש: ממלאים 'ביצוע בפועל' בתחתית ההנחות (הכנסות, עלויות, יתרה בבנק), ורואים את הסטייה בטבלה בלשונית התוצאות.",
    "4. לשנה הבאה: משנים את 'החודש הראשון במודל', ימי עבודה (לפי לוח החגים), עונתיות ויתרות פתיחה. החודשים מתעדכנים לבד.",
    "5. בשורת 'בדיקות תקינות' בדשבורד חייב להופיע '✔ הכל תקין'. אחרת: לא מחליטים לפי המספרים עד שמתקנים (פירוט בלשונית 'בדיקות').",
    "6. לא לגעת בלשוניות 'חישובים' ו'בדיקות'. סוג הוצאה חדש: מוסיפים שורה במפרט ובונים מחדש (פקודה אחת), או משתמשים ב'שונות'. שורה או נוסחה שמשנים ידנית בחישובים תסומן בבדיקות (השוואה להעתק מוגן), וזה בכוונה.",
    "הנחות חשובות: רווח לפני מס הכנסה ולפני משיכות; חנויות משלמות שוטף+30; משכורת בחודש שאחרי; מע\"מ חודשי; רכבים מסחריים. לאמת מול רואה החשבון."
  ]
}