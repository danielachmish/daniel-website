{
  "title": "תקציב ותזרים מזומנים 2027 — חברת משלוחים (דוגמה)",
  "subtitle": "כל המספרים הם הנחות לדוגמה. משנים רק בלשונית 'הנחות'; כל השאר מתעדכן לבד. סכומים לפני מע\"מ, חוץ מתזרים המזומנים.",
  "periods": ["ינו׳ 27", "פבר׳ 27", "מרץ 27", "אפר׳ 27", "מאי 27", "יוני 27", "יולי 27", "אוג׳ 27", "ספט׳ 27", "אוק׳ 27", "נוב׳ 27", "דצמ׳ 27"],
  "inputs": [
    {"section": "נפח עבודה ומחיר"},
    {"name": "DeliveriesPerDay", "label": "משלוחים ביום עבודה רגיל", "value": 250, "unit": "משלוחים", "format": "int", "min": 0, "max": 20000, "note": "ממוצע של החודשיים האחרונים לפי הלקוח"},
    {"name": "WorkingDays", "label": "ימי עבודה בחודש", "unit": "ימים", "format": "int", "min": 0, "max": 31, "series": [21, 20, 22, 18, 21, 21, 22, 21, 21, 15, 21, 22], "note": "א׳–ה׳ פחות חגים (פסח באפריל, חגי תשרי באוקטובר). לעדכן לפי לוח השנה"},
    {"name": "Seasonality", "label": "מקדם עונתיות (1 = חודש רגיל)", "unit": "מקדם", "format": "num", "min": 0, "max": 3, "series": [1.0, 0.95, 1.05, 1.1, 0.95, 0.95, 0.9, 0.9, 1.05, 1.0, 1.25, 1.15], "note": "לפני פסח ובנובמבר (בלאק פריידיי) יש יותר משלוחים; בקיץ פחות"},
    {"name": "PricePerDelivery", "label": "מחיר ממוצע שהחנות משלמת למשלוח (לפני מע\"מ)", "value": 28, "unit": "₪", "format": "money2", "min": 0, "max": 500},
    {"name": "FailedRate", "label": "אחוז משלוחים שנכשלים בניסיון הראשון", "value": 0.04, "unit": "%", "format": "pct", "note": "כל כישלון = ניסיון נוסף בלי תוספת תשלום"},
    {"section": "עלויות לכל משלוח"},
    {"name": "FuelPerDelivery", "label": "דלק למשלוח", "value": 3.2, "unit": "₪", "format": "money2", "min": 0, "max": 100},
    {"name": "RedeliveryCost", "label": "עלות ניסיון מסירה נוסף", "value": 6, "unit": "₪", "format": "money2", "min": 0, "max": 100},
    {"name": "MessagingPerDelivery", "label": "הודעות מעקב לנמען, למשלוח (מסרון או וואטסאפ)", "value": 0.25, "unit": "₪", "format": "money2", "min": 0, "max": 10, "note": "הערכה: 2–3 הודעות למשלוח. לבדוק מול הספק שנבחר"},
    {"name": "SuppliesPerDelivery", "label": "מדבקות וחומרים למשלוח", "value": 0.3, "unit": "₪", "format": "money2", "min": 0, "max": 10},
    {"section": "עובדים"},
    {"name": "Drivers", "label": "מספר נהגים", "value": 6, "unit": "נהגים", "format": "int", "min": 0, "max": 500},
    {"name": "DriverGrossSalary", "label": "שכר ברוטו לנהג בחודש", "value": 9500, "unit": "₪", "format": "money", "min": 0, "max": 100000},
    {"name": "WarehouseStaffSalary", "label": "שכר ברוטו לעובדי מחסן (סה\"כ בחודש)", "value": 11000, "unit": "₪", "format": "money", "min": 0, "max": 1000000},
    {"name": "EmployerCostRate", "label": "עלות מעסיק מעל הברוטו (ביטוח לאומי, פנסיה, פיצויים)", "value": 0.25, "unit": "%", "format": "pct", "note": "הערכה מקובלת. לאמת מול רואה החשבון"},
    {"section": "רכבים והוצאות קבועות (בחודש)"},
    {"name": "VehicleLeasePerDriver", "label": "ליסינג לרכב", "value": 3200, "unit": "₪", "format": "money", "min": 0, "max": 50000},
    {"name": "VehicleInsurancePerDriver", "label": "ביטוח לרכב (בלי מע\"מ)", "value": 450, "unit": "₪", "format": "money", "min": 0, "max": 50000},
    {"name": "WarehouseRent", "label": "שכירות מחסן", "value": 7000, "unit": "₪", "format": "money", "min": 0, "max": 1000000},
    {"name": "SoftwareMonthly", "label": "מערכת משלוחים, אחסון ותוכנות", "value": 600, "unit": "₪", "format": "money", "min": 0, "max": 100000},
    {"name": "AccountingMonthly", "label": "הנהלת חשבונות", "value": 1200, "unit": "₪", "format": "money", "min": 0, "max": 100000},
    {"name": "OtherFixed", "label": "שונות (טלפונים, משרד, אחזקה)", "value": 1500, "unit": "₪", "format": "money", "min": 0, "max": 1000000},
    {"section": "מע\"מ ומזומן"},
    {"name": "VatRate", "label": "שיעור מע\"מ", "value": 0.18, "unit": "%", "format": "pct", "note": "השיעור מינואר 2025. ההנחה: דיווח חודשי ותשלום בחודש שאחרי (בדיווח דו-חודשי: לפי רואה החשבון)"},
    {"name": "OpeningCash", "label": "מזומן בבנק בתחילת ינואר", "value": 60000, "unit": "₪", "format": "money", "min": -10000000, "max": 100000000},
    {"name": "OpeningReceivables", "label": "כסף שחנויות חייבות על דצמבר (כולל מע\"מ)", "value": 173000, "unit": "₪", "format": "money", "min": 0, "max": 100000000, "note": "החנויות משלמות שוטף+30: את דצמבר מקבלים בינואר"},
    {"name": "OpeningPayroll", "label": "משכורות דצמבר שמשולמות בינואר", "value": 85000, "unit": "₪", "format": "money", "min": 0, "max": 100000000, "note": "משכורת משולמת עד ה-9 בחודש שאחרי"},
    {"name": "OpeningVatPayable", "label": "מע\"מ על דצמבר שמשולם בינואר", "value": 17500, "unit": "₪", "format": "money", "min": -10000000, "max": 100000000},
    {"name": "MinCashBuffer", "label": "כרית ביטחון: מתחת לזה בבנק = התראה", "value": 50000, "unit": "₪", "format": "money", "min": 0, "max": 100000000},
    {"name": "Tolerance", "label": "סטייה מותרת בבדיקות התקינות (עיגול)", "value": 0.01, "unit": "₪", "format": "money2", "min": 0, "max": 100}
  ],
  "calcs": [
    {"section": "נפח והכנסות"},
    {"name": "Deliveries", "label": "משלוחים בחודש", "unit": "משלוחים", "format": "int", "formula": "=ROUND(DeliveriesPerDay*{WorkingDays}*{Seasonality},0)"},
    {"name": "FailedDeliveries", "label": "ניסיונות מסירה חוזרים", "unit": "משלוחים", "format": "int", "formula": "=ROUND({Deliveries}*FailedRate,0)"},
    {"name": "Revenue", "label": "הכנסות (לפני מע\"מ)", "unit": "₪", "format": "money", "bold": true, "formula": "={Deliveries}*PricePerDelivery"},
    {"section": "עלויות משתנות"},
    {"name": "FuelCost", "label": "דלק", "unit": "₪", "formula": "={Deliveries}*FuelPerDelivery"},
    {"name": "RedeliveryCostTotal", "label": "ניסיונות מסירה חוזרים", "unit": "₪", "formula": "={FailedDeliveries}*RedeliveryCost"},
    {"name": "MessagingCost", "label": "הודעות מעקב", "unit": "₪", "formula": "={Deliveries}*MessagingPerDelivery"},
    {"name": "SuppliesCost", "label": "מדבקות וחומרים", "unit": "₪", "formula": "={Deliveries}*SuppliesPerDelivery"},
    {"name": "VariableCosts", "label": "סה\"כ עלויות משתנות", "unit": "₪", "bold": true, "formula": "={FuelCost}+{RedeliveryCostTotal}+{MessagingCost}+{SuppliesCost}"},
    {"section": "עלויות קבועות"},
    {"name": "PayrollCost", "label": "שכר כולל עלות מעסיק", "unit": "₪", "formula": "=(Drivers*DriverGrossSalary+WarehouseStaffSalary)*(1+EmployerCostRate)"},
    {"name": "LeaseCost", "label": "ליסינג רכבים", "unit": "₪", "formula": "=Drivers*VehicleLeasePerDriver"},
    {"name": "InsuranceCost", "label": "ביטוח רכבים", "unit": "₪", "formula": "=Drivers*VehicleInsurancePerDriver"},
    {"name": "OverheadCost", "label": "מחסן, תוכנות, הנהלת חשבונות ושונות", "unit": "₪", "formula": "=WarehouseRent+SoftwareMonthly+AccountingMonthly+OtherFixed"},
    {"name": "FixedCosts", "label": "סה\"כ עלויות קבועות", "unit": "₪", "bold": true, "formula": "={PayrollCost}+{LeaseCost}+{InsuranceCost}+{OverheadCost}"},
    {"section": "רווח"},
    {"name": "TotalCosts", "label": "סה\"כ עלויות", "unit": "₪", "bold": true, "formula": "={VariableCosts}+{FixedCosts}"},
    {"name": "OperatingProfit", "label": "רווח תפעולי (לפני מס הכנסה)", "unit": "₪", "bold": true, "formula": "={Revenue}-{TotalCosts}"},
    {"name": "OperatingMargin", "label": "שיעור רווח תפעולי", "unit": "%", "format": "pct", "total": "none", "formula": "=IF({Revenue}=0,0,{OperatingProfit}/{Revenue})"},
    {"section": "מע\"מ"},
    {"name": "OutputVat", "label": "מע\"מ עסקאות (על ההכנסות)", "unit": "₪", "formula": "={Revenue}*VatRate"},
    {"name": "InputVat", "label": "מע\"מ תשומות (על הוצאות שחייבות במע\"מ)", "unit": "₪", "formula": "=({VariableCosts}+{LeaseCost}+{OverheadCost})*VatRate"},
    {"name": "NetVat", "label": "מע\"מ לתשלום על החודש", "unit": "₪", "formula": "={OutputVat}-{InputVat}"},
    {"section": "תזרים מזומנים (מה באמת נכנס ויוצא מהבנק)"},
    {"name": "Collections", "label": "גבייה מחנויות (החודש הקודם, כולל מע\"מ)", "unit": "₪", "formula": "={Revenue[-1]}*(1+VatRate)", "first": "=OpeningReceivables"},
    {"name": "PayrollPaid", "label": "תשלום משכורות (של החודש הקודם)", "unit": "₪", "formula": "={PayrollCost[-1]}", "first": "=OpeningPayroll"},
    {"name": "SupplierPayments", "label": "תשלום לספקים (כולל מע\"מ)", "unit": "₪", "formula": "={VariableCosts}+{LeaseCost}+{InsuranceCost}+{OverheadCost}+{InputVat}"},
    {"name": "VatPaid", "label": "תשלום מע\"מ (של החודש הקודם)", "unit": "₪", "formula": "={NetVat[-1]}", "first": "=OpeningVatPayable"},
    {"name": "NetCashFlow", "label": "תזרים נטו בחודש", "unit": "₪", "bold": true, "formula": "={Collections}-{PayrollPaid}-{SupplierPayments}-{VatPaid}"},
    {"name": "OpeningCashBal", "label": "יתרה בתחילת החודש", "unit": "₪", "total": "first", "formula": "={ClosingCash[-1]}", "first": "=OpeningCash"},
    {"name": "ClosingCash", "label": "יתרה בסוף החודש", "unit": "₪", "bold": true, "total": "last", "formula": "={OpeningCashBal}+{NetCashFlow}"},
    {"name": "BufferLine", "label": "כרית ביטחון", "unit": "₪", "total": "none", "formula": "=MinCashBuffer"},
    {"name": "BelowBuffer", "label": "חודש מתחת לכרית הביטחון (1 = כן)", "unit": "חודשים", "format": "int", "formula": "=IF({ClosingCash}<MinCashBuffer,1,0)"}
  ],
  "outputs": {
    "kpis": [
      {"label": "הכנסות בשנה (לפני מע\"מ)", "formula": "={Revenue:total}", "format": "money"},
      {"label": "רווח תפעולי בשנה", "formula": "={OperatingProfit:total}", "format": "money"},
      {"label": "שיעור רווח תפעולי", "formula": "=IF({Revenue:total}=0,0,{OperatingProfit:total}/{Revenue:total})", "format": "pct"},
      {"label": "רווח ממוצע לכל משלוח", "formula": "=IF({Deliveries:total}=0,0,{OperatingProfit:total}/{Deliveries:total})", "format": "money2"},
      {"label": "משלוחים בחודש שצריך כדי לכסות את ההוצאות הקבועות (נקודת איזון)", "formula": "=IF({Deliveries:total}=0,0,IF(PricePerDelivery<={VariableCosts:total}/{Deliveries:total},0,ROUNDUP(({FixedCosts:total}/COUNT({FixedCosts:row}))/(PricePerDelivery-{VariableCosts:total}/{Deliveries:total}),0)))", "format": "int", "note": "0 = המחיר לא מכסה אפילו את העלות המשתנה"},
      {"label": "יתרת המזומנים הנמוכה ביותר בשנה", "formula": "=MIN({ClosingCash:row})", "format": "money"},
      {"label": "החודש שבו היתרה הכי נמוכה", "formula": "=INDEX({Periods:row},MATCH(MIN({ClosingCash:row}),{ClosingCash:row},0))", "format": "text"},
      {"label": "חודשים מתחת לכרית הביטחון", "formula": "={BelowBuffer:total}", "format": "int"}
    ],
    "table_title": "חודש אחרי חודש",
    "table": [
      {"label": "הכנסות", "ref": "Revenue"},
      {"label": "עלויות משתנות", "ref": "VariableCosts"},
      {"label": "עלויות קבועות", "ref": "FixedCosts"},
      {"label": "רווח תפעולי", "ref": "OperatingProfit", "bold": true},
      {"label": "תזרים נטו", "ref": "NetCashFlow"},
      {"label": "יתרה בבנק בסוף החודש", "ref": "ClosingCash", "total": "last", "bold": true},
      {"label": "כרית ביטחון", "ref": "BufferLine", "total": "none"}
    ],
    "chart": {"title": "יתרה בבנק בסוף כל חודש מול כרית הביטחון", "rows": ["ClosingCash", "BufferLine"], "type": "line"}
  },
  "checks": [
    {"label": "סה\"כ עלויות שנתי = סכום כל רכיבי העלות", "formula": "=ABS({TotalCosts:total}-({FuelCost:total}+{RedeliveryCostTotal:total}+{MessagingCost:total}+{SuppliesCost:total}+{PayrollCost:total}+{LeaseCost:total}+{InsuranceCost:total}+{OverheadCost:total}))<=Tolerance"},
    {"label": "רווח שנתי = הכנסות פחות עלויות", "formula": "=ABS({OperatingProfit:total}-({Revenue:total}-{TotalCosts:total}))<=Tolerance"},
    {"label": "גשר מזומנים: יתרת סוף שנה = יתרת פתיחה + תזרים נטו של כל השנה", "formula": "=ABS({ClosingCash:last}-(OpeningCash+{NetCashFlow:total}))<=Tolerance"},
    {"label": "גבייה: חוב פתיחה + הכנסות כולל מע\"מ = נגבה + חוב סגירה", "formula": "=ABS(OpeningReceivables+{Revenue:total}*(1+VatRate)-{Collections:total}-{Revenue:last}*(1+VatRate))<=Tolerance"},
    {"label": "מע\"מ: חוב פתיחה + מע\"מ השנה = שולם + חוב סגירה", "formula": "=ABS(OpeningVatPayable+{NetVat:total}-{VatPaid:total}-{NetVat:last})<=Tolerance"},
    {"label": "שכר: חוב פתיחה + שכר השנה = שולם + חוב סגירה", "formula": "=ABS(OpeningPayroll+{PayrollCost:total}-{PayrollPaid:total}-{PayrollCost:last})<=Tolerance"},
    {"label": "הטבלה בלשונית התוצאות תואמת לחישובים (רווח ויתרה)", "formula": "=AND(ABS({Out_OperatingProfit:total}-{OperatingProfit:total})<=Tolerance,ABS({Out_ClosingCash:last}-{ClosingCash:last})<=Tolerance)"},
    {"label": "אין חודש עם מספר משלוחים שלילי", "formula": "=MIN({Deliveries:row})>=0"}
  ],
  "howto": [
    "1. משנים מספרים רק בלשונית 'הנחות', בתאים הצהובים עם הכתב הכחול. כל השאר מחושב ונעול כדי שלא יימחק בטעות.",
    "2. התוצאה המרכזית בלשונית 'תוצאות': רווח שנתי, היתרה הנמוכה בבנק ובאיזה חודש, וגרף של היתרה מול כרית הביטחון.",
    "3. 'מה אם': משנים מחיר למשלוח, מספר נהגים או משלוחים ביום, ורואים מיד מה קורה לרווח ולמזומן.",
    "4. לשונית 'בדיקות' חייבת להראות TRUE בכל השורות (ובלשונית התוצאות: '✔ הכל תקין'). FALSE = לא מחליטים לפי המספרים עד שמתקנים.",
    "5. לא לגעת: לשוניות 'חישובים' ו'בדיקות'. צריך לשנות מבנה? ביטול הגנה: סקירה > ביטול הגנת גיליון (אין סיסמה).",
    "הנחות חשובות: סכומי הרווח לפני מע\"מ ולפני מס הכנסה; חנויות משלמות שוטף+30; משכורת משולמת בחודש שאחרי; מע\"מ מדווח חודשי. לאמת מול רואה החשבון."
  ]
}
